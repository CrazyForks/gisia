- if participants.empty?
  %div{ class: 'px-3 py-2 text-slate-500 text-sm' } No matching users
- else
  %ul{ class: 'list-none m-0 p-0', role: 'listbox' }
    - participants.each_with_index do |participant, index|
      %li{ id: "markdown-autocomplete-item-#{index}",
           role: 'option',
           'aria-selected': index.zero?,
           class: "px-3 py-2 cursor-pointer flex items-center gap-2 #{index.zero? ? 'bg-blue-50' : ''}",
           data: { markdown_autocomplete_target: 'item', value: participant[:username] } }
        - if participant[:type].blank?
          %span{ class: 'w-6 h-6 rounded-full bg-slate-200 flex items-center justify-center text-slate-600' }
            = icon 'users', class: 'w-3 h-3'
        - else
          = image_tag participant[:avatar_url].presence || default_avatar, class: 'w-6 h-6 rounded-full object-cover', alt: participant[:username]
        %span{ class: 'text-sm font-medium text-slate-900' }= participant[:username]
        - if participant[:name].present?
          %span{ class: 'text-xs text-slate-500 truncate' }= participant[:name]
