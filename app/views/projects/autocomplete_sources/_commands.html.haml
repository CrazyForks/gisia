- if commands.empty?
  %div{ class: 'px-3 py-2 text-slate-500 text-sm' } No matching commands
- else
  %ul{ class: 'list-none m-0 p-0', role: 'listbox' }
    - commands.each_with_index do |command, index|
      %li{ id: "markdown-autocomplete-item-#{index}",
           role: 'option',
           'aria-selected': index.zero?,
           class: "px-3 py-2 cursor-pointer flex items-center gap-2 #{index.zero? ? 'bg-blue-50' : ''}",
           data: { markdown_autocomplete_target: 'item', value: command[:name] } }
        %span{ class: 'text-sm font-medium text-slate-900' }= "/#{command[:name]}"
        - if command[:description].present?
          %span{ class: 'text-xs text-slate-500 truncate' }= command[:description]
